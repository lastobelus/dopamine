{
  "name": "dopamine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit",
    "lint": "vp lint --deny-warnings --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test run",
    "knip:check": "knip --no-config-hints",
    "ci": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && pnpm knip:check",
    "lastcode:pr-gates": "node scripts/lastcode-pr-gates.ts",
    "lastcode:merge": "node scripts/lastcode-merge.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "@types/node": "24.12.4",
    "knip": "6.34.0",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
